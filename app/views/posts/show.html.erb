<div class="container py-5">
  <div class="row g-4 align-items-start">
    <div class="col-lg-7">
      <% if @post.image.attached? %>
        <%= image_tag @post.image, class: "img-fluid rounded-4 shadow-sm w-100", style: "height: 860px; object-fit: cover;" %>
      <% else %>
        <div class="d-flex align-items-center justify-content-center bg-light text-muted rounded-4 shadow-sm" style="height: 560px;">
          Sem imagem
        </div>
      <% end %>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <%= link_to "<- Voltar", posts_path, class: "text-decoration-none text-body-secondary" %>
          <h1 class="card-title mb-3"><%= @post.title %></h1>
          <p class="card-text fs-5"><%= @post.description %></p>
          <div class="d-flex  gap-2 mt-auto text-secondary">
                <i class="bi bi-person-fill"></i>
                <p class="small"><%= @post.user.email%></p>
          </div>

          <% if user_signed_in? && current_user == @post.user %>
            <div class="mt-4 d-flex flex-wrap gap-2">
              <%= link_to edit_post_path(@post), class: "btn fw-bold" do %>
                <i class="bi bi-pencil-square"></i> Editar
              <% end %>
              <%= button_to @post, method: :delete, class: "btn fw-bold" do %>
                <i class="bi bi-trash" style="color: #fd0000"></i> Excluir
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-5">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body p-4"> 
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-chat-fill fs-1 pb-2" ></i>
            <span class="fw-bold h2">Comentários</span>
          </div>
        

          <% if user_signed_in? %>
            <%= form_with model: [@post, Comment.new], local: true do |form| %>
              <div class="mb-3">
                <%= form.label :content, "Comentário", class: "form-label" %>
                <%= form.text_area :content, class: "form-control", rows: 3 %>
              </div>

              <%= form.submit "Comentar", class: "btn btn-primary" %>
            <% end %>
          <% else %>
            <div class="alert alert-light border">
              <%= link_to "Entre", new_user_session_path, class: "fw-bold text-decoration-none" %> ou <%= link_to "cadastre-se", new_user_registration_path, class: "fw-bold text-decoration-none" %> para comentar.
            </div>
          <% end %>

          <div class="mt-4">
            <% if @post.comments.any? %>
              <% @post.comments.each do |comment| %>
                <div class="border rounded p-3 mb-3">
                  <div class="d-flex flex-row align-items-center justify-content-between">
                    <div>
                      <i class="bi bi-person-fill"></i>
                      <strong><%= comment.user.email %></strong>
                    </div>
                    <% if user_signed_in? && current_user == comment.user %>
                      <%= button_to [@post, comment], method: :delete, form: { data: { turbo_confirm: "Tem certeza?" } }, class: "btn fw-bold" do %>
                        <i class="bi bi-trash" style="color: #fd0000"></i> Excluir
                      <% end %>
                    <% end %>
                  </div>
                  <p class="mb-0"><%= comment.content %></p>
                  
                </div>
              <% end %>
            <% else %>
              <p class="text-muted">Ainda não há comentários.</p>
            <% end %>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>


