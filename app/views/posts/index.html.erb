<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<div class="container py-5">
  <div class="d-flex justify-content-end align-items-end mb-4">
    <%= link_to "Novo post", new_post_path, class: "btn btn-danger" %>
  </div>

  <% if @posts.any? %>
    <div id="posts" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
      <% @posts.each do |post| %>
        <div class="col">
          <article class="card h-100 shadow-sm border-0">
            <% if post.image.attached? %>
              <%= image_tag post.image, class: "card-img-top rounded-4", style: "height: 320px; object-fit: cover;" %>
            <% else %>
              <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="height: 220px;">
                Sem imagem
              </div>
            <% end %>

            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= post.title %></h5>
              <p class="card-text text-secondary"><%= truncate(post.description.to_s, length: 120) %></p>

              <div class="mt-auto">
                <%= link_to "Ver post", post, class: "btn btn-outline-primary btn-sm" %>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-light border text-center">
      Nenhum post cadastrado ainda.
    </div>
  <% end %>
</div>


