    <div class="w-100" style="max-width: 760px;">
      <div class="mb-4">
        <%= link_to "← Voltar", posts_path, class: "text-decoration-none text-body-secondary fw-semibold" %>
      </div>

      <h2 class="mb-4 fw-bold">Editar post</h2>
    </div>
  </div>

  <%= render "form", post: @post %>
</div>
